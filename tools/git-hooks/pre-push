#!/usr/bin/env bash
# Pre-push secret gate for the RAMEAU release repository.
#
# WHY THIS EXISTS, specifically:
#
# GitHub's own push protection would block a credential at the door, before the object
# reaches the remote. It is NOT available on this repository: secret scanning returns
# HTTP 422 and rulesets return HTTP 403 while the repository is private on this plan.
# Both become available when it goes public, which is exactly backwards from when they
# are most needed -- the private window is when the source tree lands.
#
# So the only remote gate is CI, and CI runs AFTER the push has landed. A credential
# caught there has already left the machine, and rotation rather than deletion is then
# the only remediation. This hook restores the "block before it leaves" property locally.
#
# Install:
#     git config core.hooksPath tools/git-hooks
# or:
#     cp tools/git-hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#
# This hook FAILS CLOSED. If gitleaks is not installed, the push is refused rather than
# waved through, because a gate that silently disables itself when its tool is missing is
# worse than no gate: it produces the appearance of protection. Override only with a
# deliberate, visible environment variable, and only when you have checked by hand:
#
#     RAMEAU_SKIP_SECRET_GATE=1 git push
#
set -euo pipefail

say() { printf 'pre-push: %s\n' "$1" >&2; }

# --- telling a CRASH apart from a VERDICT ---------------------------------------------
# gitleaks exits nonzero for two unrelated reasons: it found secrets, or it did not
# finish. Collapsing them is how this hook once refused a CLEAN push with the message
# "gitleaks reported ? finding(s)" -- measured on Windows, where `mktemp -d` yields a
# POSIX path that a native binary cannot write, so the scan ran, found nothing, and then
# died writing its report. Refusing was right; the reason was invented.
#
# So the decision is made from SHAPE, not from the exit code alone, and deliberately
# WITHOUT an interpreter: a report that exists and is non-empty means gitleaks got far
# enough to write a verdict, and an absent or empty one means it did not. `[ -s ]` needs
# nothing but the shell, so the refuse-or-proceed path cannot be broken by a missing
# python -- which is the second, independent cause of the same `?`.
scan_completed() { [ -s "$1" ]; }

# Counting is a REFINEMENT, not the decision. Prints the count and returns 0; returns 1
# when a report exists but does not parse; returns 2 when no interpreter was found.
# python3 first and `python` second: the original tried bare `python`, which is absent on
# most Linux boxes, and a count that fails must never become a number.
count_findings() {
    _cf_py=""
    for _cf_c in python3 python; do
        if command -v "$_cf_c" >/dev/null 2>&1; then _cf_py="$_cf_c"; break; fi
    done
    [ -n "$_cf_py" ] || return 2
    "$_cf_py" -c 'import json,sys; print(len(json.load(open(sys.argv[1]))))' "$1" 2>/dev/null || return 1
}

# Report paths only. `--source` was measured working as a POSIX path on the box where the
# report path failed, so converting it too would be a change beyond the measurement.
# Where cygpath is absent -- every Linux box -- this is the identity function.
native_path() {
    if command -v cygpath >/dev/null 2>&1; then cygpath -w "$1"; else printf '%s' "$1"; fi
}

# One message for the one condition that must never be reported as findings.
refuse_incomplete() {
    say ""
    say "PUSH REFUSED: the scan did NOT COMPLETE, so this push is UNCHECKED."
    say "  scanner:     $GITLEAKS"
    say "  report path: $1"
    say ""
    say "gitleaks exited nonzero without leaving a readable report, which means it failed"
    say "rather than found something. Look above for its own error -- a 'could not write'"
    say "is the common one, and on Windows it means the report path is a POSIX path a"
    say "native binary cannot write."
    say ""
    say "This is NOT a report of findings and no count is shown, because none was measured."
    say "The push is refused because an unchecked push is what this hook exists to prevent."
}

if [ "${RAMEAU_SKIP_SECRET_GATE:-0}" = "1" ]; then
    say "SKIPPED by RAMEAU_SKIP_SECRET_GATE=1. You have taken responsibility for this push."
    exit 0
fi

# The binary is normally on PATH. RAMEAU_GITLEAKS names it explicitly for the common
# case of a package manager that installs outside PATH (winget and Homebrew casks both
# do this). It is an env var rather than a list of search paths in this file, because a
# hardcoded install location is one machine's detail and this repository is published.
GITLEAKS="${RAMEAU_GITLEAKS:-gitleaks}"

if ! command -v "$GITLEAKS" >/dev/null 2>&1; then
    say "REFUSING: gitleaks was not found, so this push cannot be checked."
    say "  looked for: $GITLEAKS"
    say ""
    say "This hook fails closed on purpose. GitHub push protection is unavailable on this"
    say "repository while it is private, so this is the only gate that runs before the"
    say "objects leave this machine."
    say ""
    say "Install gitleaks, or point RAMEAU_GITLEAKS at the binary, or override"
    say "deliberately with RAMEAU_SKIP_SECRET_GATE=1."
    exit 1
fi

say "gitleaks $("$GITLEAKS" version 2>/dev/null || echo '(version unknown)')"

# --- control: prove the scanner fires before trusting a zero --------------------------
# A clean report is exactly the output nobody re-checks. The canary is GENERATED rather
# than written literally, for two reasons: a literal key in this file would itself be a
# finding when the tree is scanned, and the obvious choice -- AWS's documented example
# key -- is ALLOWLISTED BY GITLEAKS BY DEFAULT, because it appears throughout AWS's own
# documentation. That mistake was made once in this repository's CI and the control
# caught it. base32 emits A-Z2-7, which satisfies the AWS key shape; `cut` rather than a
# second `head` avoids a SIGPIPE under `set -o pipefail`.
control_dir="$(mktemp -d)"
cleanup() { rm -rf "$control_dir"; }
trap cleanup EXIT

(
    cd "$control_dir"
    git init -q .
    key="AKIA$(LC_ALL=C head -c 64 /dev/urandom | base32 | tr -d '=' | tr -cd 'A-Z0-9' | cut -c1-16)"
    printf 'aws_access_key_id = %s\n' "$key" > creds.txt
    git add creds.txt
    git -c user.email=hook@example.invalid -c user.name=hook commit -qm canary
)

# THE CONTROL MUST RUN THE SAME ARGUMENTS AS THE GATE, and until 2026-11-02 it did not.
# It omitted --report-format and --report-path -- and --report-path is the one that failed
# in the field. So the control printed "control ok" truthfully, certifying a scan that
# then crashed on an argument the control had never passed. A control that cannot fail the
# way its subject fails cannot detect its subject's failure, and this one was worse than
# useless: it affirmatively greenlit, so the crash that followed read as a verdict.
#
# It also needs the gate's classification, for the same reason the gate does: a crash and
# a finding both exit nonzero, so "nonzero" alone would read an unwritable report path as
# a successfully-flagged canary.
control_report="$control_dir/control.json"
if "$GITLEAKS" detect \
        --source "$control_dir" \
        --no-banner \
        --redact \
        --exit-code 1 \
        --report-format json \
        --report-path "$(native_path "$control_report")" >/dev/null 2>&1; then
    say "CONTROL FAILED: gitleaks did not flag a generated known-positive."
    say "The scan below would be meaningless, so this push is refused."
    exit 1
fi
if ! scan_completed "$control_report"; then
    say "CONTROL FAILED: gitleaks could not complete even the control scan."
    refuse_incomplete "$control_report"
    exit 1
fi
say "control ok: the scanner flags a planted credential, and can write its report"

# --- the gate: LOCAL HISTORY ----------------------------------------------------------
# This scans git objects, which is exactly what a push sends. A value that was committed
# and later removed is still reachable, and stopping such an object before it reaches a
# remote is this hook's whole purpose.
#
# It does NOT scan the working tree, and an earlier version of this hook SAID IT DID.
# `gitleaks detect --source X` traverses history; the worktree needs `--no-git`, which is
# the separate advisory pass below. Measured: a credential written to an uncommitted file
# exits 0 here and is caught only by `--no-git`. The gate was never bypassable -- only
# committed objects get pushed, and those are precisely what this scans -- but the
# success message claimed a check that had not run, which is the defect this repository's
# own rule exists to prevent.
repo_root="$(git rev-parse --show-toplevel)"
findings_report="$control_dir/findings.json"

say "scanning local history -- this is the gate, and it covers everything a push sends..."
if ! "$GITLEAKS" detect \
        --source "$repo_root" \
        --redact \
        --no-banner \
        --exit-code 1 \
        --report-format json \
        --report-path "$(native_path "$findings_report")"; then
    # Crash or verdict? Decide from the report, never from the exit code alone.
    if ! scan_completed "$findings_report"; then
        refuse_incomplete "$findings_report"
        exit 1
    fi
    _st=0
    count="$(count_findings "$findings_report")" || _st=$?
    say ""
    if [ "$_st" -eq 0 ] && [ "${count:-0}" -gt 0 ] 2>/dev/null; then
        say "PUSH REFUSED: gitleaks reported ${count} finding(s)."
    elif [ "$_st" -eq 0 ]; then
        # Completed, wrote a report, exited nonzero, and the report holds nothing. That is
        # a scanner fault rather than a finding, and saying "0 finding(s)" would be the
        # same mis-description in the other direction.
        say "PUSH REFUSED: gitleaks exited nonzero but its report contains NO findings."
        say "That is a scanner fault, not a secret. Read its output above before assuming"
        say "this tree is dirty; the push is refused because the check is inconclusive."
        exit 1
    elif [ "$_st" -eq 2 ]; then
        say "PUSH REFUSED: gitleaks reported findings. The count is not shown because no"
        say "python interpreter was found to read the report -- the findings themselves are"
        say "listed above, which is what matters."
    else
        say "PUSH REFUSED: gitleaks reported findings and its report did not parse, so the"
        say "count is not shown. The findings are listed above."
    fi
    say ""
    say "Findings are REDACTED above, with the file and line of each. Do not paste a value"
    say "anywhere to investigate it -- open the file and line directly."
    say ""
    say "If a value here is real and has ever been pushed anywhere, deleting the line is"
    say "NOT the fix. The value must be ROTATED. A commit that removes it only makes it"
    say "harder to find."
    exit 1
fi

say "clean: no findings in local history"

# --- the gate: PRIVATE ADDRESSES AND INTERNAL HOSTNAMES -------------------------------
# gitleaks does not cover this, and that is measured rather than assumed: a file whose
# entire content is `ROUTER_URL = "http://<an RFC1918 address>:8089"` is reported by
# gitleaks as "no leaks found" with exit 0. README.md and CLAUDE.md both state the rule as
# "credential, key, token, password, private address or internal hostname"; everything
# above this line enforces the first four. Until this gate existed, the number of
# instruments covering the last two was ZERO -- and the one leak this repository has
# actually had was in that half: an earlier shared/test_resolver.py carried a private /24
# and was caught by a person reading the file, not by any gate.
#
# SCOPE, stated because overclaiming is the defect this file keeps being corrected for:
#
#   * It scans the COMMITTED content at HEAD (`--rev HEAD`), not the working tree. A push
#     sends objects, not files on disk, and the two can differ. The working-tree pass
#     below stays advisory for the same reason it is advisory for gitleaks.
#   * It is TIP-ONLY. gitleaks above walks all of local history; this does not. A private
#     address that was committed earlier and removed by HEAD will NOT be caught here.
#     That gap is real and is written down rather than papered over.
#   * Addresses are covered completely. Internal hostnames are covered only where they
#     carry a reserved DNS suffix: in a Compose project a bare single-label host is the
#     same shape as a service name (`http://router:8080`), so no rule can tell them
#     apart. See tools/scan_private_literals.py for that measurement.
#
# FAILS CLOSED, like the gitleaks gate: no interpreter means no check, and a check that
# quietly skips itself manufactures the appearance of protection. Python is already a hard
# dependency of this project (3.11+ per CLAUDE.md, and shared/resolver.py ships with it),
# so refusing is the right answer rather than an inconvenience.
PL_SCANNER="$repo_root/tools/scan_private_literals.py"

# `command -v` is NOT enough, measured on this machine: Windows ships a `python3` App
# Execution Alias that exists on PATH, prints "Python was not found..." and exits
# NONZERO. So presence was found, the interpreter did not run, and -- because nonzero is
# the pass condition for the control below -- the control read that crash as "the gate
# fired". A control that cannot tell a crash from a verdict is the exact defect this file
# has already been corrected for once, at the gitleaks step. So probe that each candidate
# actually EXECUTES.
_pl_py=""
for _pl_c in python3 python; do
    if command -v "$_pl_c" >/dev/null 2>&1 \
       && "$_pl_c" -c 'pass' >/dev/null 2>&1; then _pl_py="$_pl_c"; break; fi
done

if [ -z "$_pl_py" ]; then
    say ""
    say "REFUSING: no python interpreter, so the private-address gate cannot run."
    say "This hook fails closed on purpose. gitleaks has no rule for a private address or"
    say "an internal hostname, so skipping this check would leave half of the documented"
    say "rule unenforced while reporting a clean push."
    say "Install python3, or override deliberately with RAMEAU_SKIP_SECRET_GATE=1."
    exit 1
fi

if [ ! -f "$PL_SCANNER" ]; then
    say ""
    say "REFUSING: $PL_SCANNER is missing."
    say "A gate that cannot find its own checker must not report success."
    exit 1
fi

# The control, for the same reason gitleaks gets one: a clean verdict is the output nobody
# re-checks. The planted address is GENERATED from $RANDOM, so this hook contains no
# address belonging to anyone -- which is also the rule the scanner itself is built on.
_pl_probe_dir="$control_dir/plcanary"
mkdir -p "$_pl_probe_dir"
printf 'ROUTER_URL = "http://10.%d.%d.%d:8089"\n' \
    "$(( RANDOM % 254 + 1 ))" "$(( RANDOM % 254 + 1 ))" "$(( RANDOM % 254 + 1 ))" \
    > "$_pl_probe_dir/probe.py"

# Nonzero alone is NOT enough to call this control passed -- a crashing interpreter also
# exits nonzero, which is how an earlier version of this block reported "control ok" while
# the scanner had never run. So require the VERDICT LINE, the same shape-not-exit-code
# discipline the gitleaks step uses, and then require it to be the FAIL verdict.
# `|| _pl_probe_rc=$?` rather than a bare call followed by `$?`: this file runs under
# `set -euo pipefail` (line 28), so a bare command that exits nonzero aborts the script
# THERE -- before the status is read and before any message is printed. Measured: the
# first version of this block made the hook exit 1 having said nothing at all, which is
# worse than either verdict, because a silent refusal looks like a crash in git itself.
# Nonzero is the EXPECTED outcome here, so it must not be fatal.
_pl_probe_out="$control_dir/plcanary.out"
_pl_probe_rc=0
"$_pl_py" "$PL_SCANNER" --root "$_pl_probe_dir" --paths probe.py \
    >"$_pl_probe_out" 2>&1 || _pl_probe_rc=$?

if ! grep -q '^VERDICT:' "$_pl_probe_out" 2>/dev/null; then
    say ""
    say "CONTROL DID NOT COMPLETE: the private-address scanner printed no verdict line,"
    say "so it did not run to a conclusion. Its output was:"
    sed 's/^/pre-push:   /' "$_pl_probe_out" >&2
    say ""
    say "This is a scanner or interpreter fault, not a finding. The push is refused"
    say "because the check is inconclusive, which is not the same as dirty."
    exit 1
fi

if [ "$_pl_probe_rc" -eq 0 ] || ! grep -q '^VERDICT: FAIL' "$_pl_probe_out"; then
    say ""
    say "CONTROL FAILED: the private-address gate did not flag a generated RFC1918"
    say "address. The scan below cannot be trusted, so this push is refused on purpose."
    exit 1
fi
say "control ok: the private-address gate flags a generated private address"

say "scanning committed content at HEAD for private addresses and internal hostnames..."

# CRASH OR VERDICT, for the gate and not only for its control. The control above got this
# discipline first and the gate did not, and the gap bit immediately: a bug in the
# scanner's --audit path raised UnboundLocalError, exited nonzero, and this step reported
# "PUSH REFUSED: a private address ... is in the committed content" -- refusing for a
# reason that was not true. Same lesson as the gitleaks step: decide from the printed
# verdict, never from the exit code alone.
_pl_out="$control_dir/private-literals.out"
_pl_rc=0
"$_pl_py" "$PL_SCANNER" --root "$repo_root" --rev HEAD --audit \
    >"$_pl_out" 2>&1 || _pl_rc=$?
cat "$_pl_out" >&2

if ! grep -q '^VERDICT:' "$_pl_out" 2>/dev/null; then
    say ""
    say "PUSH REFUSED: the private-address scan DID NOT COMPLETE -- it printed no verdict"
    say "line, so it did not reach a conclusion. Its output is above."
    say ""
    say "That is a scanner fault, not a finding. Nothing is claimed about this tree; the"
    say "push is refused because the check is inconclusive, which is not the same as dirty."
    exit 1
fi

if [ "$_pl_rc" -ne 0 ]; then
    say ""
    say "PUSH REFUSED: a private address or internal hostname is in the committed content."
    say ""
    say "Values are NOT printed above, by design -- each finding gives rule, path, line,"
    say "length and character class, which is enough to open the file and see it."
    say ""
    say "If a literal is DELIBERATE -- a test fixture proving the resolver accepts a"
    say "private address, say -- annotate that line with 'rameau-scan: allow' and the"
    say "exception becomes visible in the diff instead of hidden in a skip list."
    say ""
    say "If it is NOT deliberate: removing the line is not enough once it has been pushed."
    say "An address that has left this machine has left it. Treat it as a disclosure."
    exit 1
fi
say "clean: no private address or internal hostname in the committed content at HEAD"

# --- advisory: THE WORKING TREE -------------------------------------------------------
# ADVISORY, and deliberately not a gate. `--no-git` reads files from disk, which includes
# untracked AND gitignored ones -- measured: both are reported. A local `.env` that
# .gitignore exists precisely to keep out of the repository would therefore refuse every
# push, and a gate that blocks on files it is not sending is one people turn off with
# RAMEAU_SKIP_SECRET_GATE=1. A gate nobody runs protects nothing, so this warns instead.
#
# Warning costs nothing here: if any of it is ever committed, the scan above refuses it.
say ""
say "advisory pass: scanning the working tree (NOT a gate -- see the note below)..."
worktree_report="$control_dir/worktree.json"
if ! "$GITLEAKS" detect \
        --no-git \
        --source "$repo_root" \
        --redact \
        --no-banner \
        --exit-code 1 \
        --report-format json \
        --report-path "$(native_path "$worktree_report")"; then
    # The same crash-or-verdict question, and here getting it wrong asserted a FACT ABOUT
    # THE WORKING TREE that was never measured -- "? finding(s) are in the WORKING TREE".
    # An unmeasured claim stated as a finding is the thing this repository's rules are most
    # consistent about refusing, and it is worse here than in the gate above, because this
    # path does not block: the operator is told their tree is dirty and then waved through.
    if ! scan_completed "$worktree_report"; then
        say ""
        say "NOTE: the advisory working-tree scan DID NOT COMPLETE, so nothing is claimed"
        say "about the working tree either way. The push is not blocked by this -- the"
        say "advisory pass never blocks -- but it also told you nothing. See the scanner's"
        say "own error above."
    else
    _wst=0
    wcount="$(count_findings "$worktree_report")" || _wst=$?
    say ""
    if [ "$_wst" -eq 0 ]; then
        say "NOTE: the push is NOT blocked by the above. ${wcount} finding(s) are in the WORKING"
        say "TREE, which a push does not send, so the push proceeds."
    else
        say "NOTE: the push is NOT blocked by the above. There are findings in the WORKING"
        say "TREE, which a push does not send, so the push proceeds. The count is not shown"
        say "because the report could not be read."
    fi
    say ""
    say "That list includes untracked and gitignored files, so a local .env may appear here"
    say "and be entirely correct. Read each one before you commit it: once committed, the"
    say "history gate above refuses the push, and by then rotation is the only remedy."
    fi
else
    say "advisory: working tree clean too"
fi

exit 0
