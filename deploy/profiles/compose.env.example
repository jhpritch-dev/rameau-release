# RAMEAU endpoints -- values for running INSIDE A CONTAINER NETWORK.
#
# Generated from shared/resolver.py: `python shared/resolver.py
# --compose-example`. Edit the registry, not this file.
#
# Each host below is a COMPOSE SERVICE NAME and must match the service
# names in the compose file. They are resolved by the container network's
# DNS, not by the host, which is why loopback is wrong here.
#
# A blank value counts as unset, so an endpoint your profile does not
# run may be left empty.

# arbiter -- the adjudication service for multi-candidate tier output
#   only needed for: arbitration
RAMEAU_ARBITER_URL=http://arbiter:8082

# broadcaster -- fan-out of request/response events to observers
#   only needed for: observability
RAMEAU_BROADCASTER_URL=http://broadcaster:8090

# embed -- the embedding endpoint; kept separate so embeddings never contend with generation on one accelerator
#   only needed for: embeddings
RAMEAU_EMBED_URL=http://embed:11434

# kb -- the retrieval service backing knowledge-base lookups
#   only needed for: retrieval
RAMEAU_KB_URL=http://kb:8090

# ollama -- the local inference backend serving the generation tiers
RAMEAU_OLLAMA_URL=http://ollama:11434

# router -- the router's own OpenAI-compatible base; clients and self-checks use it
RAMEAU_ROUTER_URL=http://router:8080

# router_chat -- full chat-completions URL, when a client needs the path and not the base
RAMEAU_ROUTER_CHAT_URL=http://router:8080/v1/chat/completions

# router_health -- readiness probe target; reports backend reachability in its BODY
RAMEAU_ROUTER_HEALTH_URL=http://router:8080/health

# search -- the self-hosted metasearch endpoint used by the research path
#   only needed for: search
RAMEAU_SEARCH_URL=http://search:8080
