# RAMEAU endpoints -- values for running the router DIRECTLY ON A HOST.
#
# Generated from shared/resolver.py: `python shared/resolver.py
# --env-example`. Edit the registry, not this file.
#
# NOT FOR A CONTAINER. Inside a container 127.0.0.1 is the container
# itself, so these values would point every endpoint at the container's
# own loopback. For Compose use deploy/profiles/compose.env.example,
# which addresses services by name.
#
# There are no built-in defaults: an unset endpoint fails at resolution
# naming the variable. BLANK EVERY ENDPOINT YOU DO NOT RUN: a blank
# value counts as unset, which is the safe state, and a wrong endpoint
# is worse than no endpoint -- the same reason RAMEAU_OLLAMA_URL ships
# with no default at all.

# arbiter -- the adjudication service for multi-candidate tier output
#   only needed for: arbitration
RAMEAU_ARBITER_URL=http://127.0.0.1:8082

# broadcaster -- fan-out of request/response events to observers
#   only needed for: observability
RAMEAU_BROADCASTER_URL=http://127.0.0.1:8092

# embed -- the embedding endpoint; kept separate so embeddings never contend with generation on one accelerator
#   only needed for: embeddings
RAMEAU_EMBED_URL=http://127.0.0.1:11436

# kb -- the retrieval service backing knowledge-base lookups
#   only needed for: retrieval
RAMEAU_KB_URL=http://127.0.0.1:8091

# ollama -- the local inference backend serving the generation tiers
RAMEAU_OLLAMA_URL=http://127.0.0.1:11434

# router -- the router's own OpenAI-compatible base; clients and self-checks use it
RAMEAU_ROUTER_URL=http://127.0.0.1:8080

# router_chat -- full chat-completions URL, when a client needs the path and not the base
RAMEAU_ROUTER_CHAT_URL=http://127.0.0.1:8080/v1/chat/completions

# router_health -- readiness probe target; reports backend reachability in its BODY
RAMEAU_ROUTER_HEALTH_URL=http://127.0.0.1:8080/health

# search -- the self-hosted metasearch endpoint used by the research path
#   only needed for: search
RAMEAU_SEARCH_URL=http://127.0.0.1:8888
